# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# voice server dependencies
/voice-server/node_modules
/portal-worker/node_modules
eval/results.json
eval/sim-results.json
eval/report-*.md

# test runs (tests/README.md): keys, downloads, logs and screenshots, and what the stand-ins record
/tests/.out/
/tests/fakes/*.jsonl
/tests/fakes/*.json
/tests/fakes/*.log
/tests/fakes/carrier.txt
/tests/fakes/outage-*
/pilot-kit/
