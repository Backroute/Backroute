# Copy to .env.local (never committed) and fill in. Everything is optional: with nothing set, the app is the demo.
# DEPLOY.md says where each value comes from and what it switches on.

# "off" on the real site removes the demo completely (no /demo, no demo links, no sample data). Leave unset on the demo site.
NEXT_PUBLIC_DEMO=
# "off" removes the sample fleet a signed-in owner can practice on (it lives only in that browser tab, nothing saved or sent).
NEXT_PUBLIC_SAMPLE=

# ── Supabase: accounts, saved data ──
NEXT_PUBLIC_SUPABASE_URL=
# The anon / publishable key. Safe in the browser: the database's access rules still apply.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# The service_role / secret key: server only, for acting on texts, calls and email. Never NEXT_PUBLIC.
SUPABASE_SERVICE_ROLE_KEY=

# ── Anthropic (Claude): the AI ── server only
ANTHROPIC_API_KEY=
# "on" lets demo visitors get real AI answers too (15 an hour each). Costs you API usage.
AI_IN_DEMO=

# ── Twilio: the dispatch number drivers text and call ──
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# One of these two: the number itself (+14695550199) or a Messaging Service.
TWILIO_FROM_NUMBER=
TWILIO_MESSAGING_SERVICE_SID=
# Your public web address, e.g. https://backroute.vercel.app. Twilio signs requests with it.
PUBLIC_BASE_URL=

# ── Postmark: broker email ──
POSTMARK_SERVER_TOKEN=
# The verified address replies are sent from, e.g. dispatch@yourdomain.com
EMAIL_FROM=
# Postmark's inbound address, e.g. abc123@inbound.postmarkapp.com (each carrier gets +their-key)
EMAIL_INBOUND_ADDRESS=
# A long random secret, also put in the inbound webhook URL as ?token=
EMAIL_WEBHOOK_TOKEN=

# ── The jobs: the owner's evening text and the dispatcher's rounds (/api/cron/dispatch every ~10 minutes) ──
CRON_SECRET=

# ── FMCSA QCMobile web key (free: https://mobile.fmcsa.dot.gov/QCDevsite/): MC lookups at sign-up, and the AI's ──
# ── check of every broker before it books with them. Without it, new brokers wait for the support team.       ──
FMCSA_WEB_KEY=

# ── Backroute's support team: phones that get a text for anything urgent (a crash, a driver who can't be reached) ──
# Comma-separated, e.g. +13125550100,+13125550101. Support staff are added in the database (DEPLOY.md, "Your support team").
SUPPORT_PHONES=

# ── Load boards: Backroute's partner logins, set once each board's agreement is signed (DEPLOY.md, step 9). ──
# ── Until then, carriers can save their side and it waits.                                                  ──
TRUCKSTOP_WS_USERNAME=
TRUCKSTOP_WS_PASSWORD=
# The web-service address Truckstop gives with the login (their test one: https://testws.truckstop.com)
TRUCKSTOP_WS_BASE=
DAT_SERVICE_EMAIL=
DAT_SERVICE_PASSWORD=
# Only if DAT gives different addresses than the defaults
DAT_IDENTITY_BASE=
DAT_FREIGHT_BASE=

# ── Google Places API (New): repair shops, tire service and towing near a broken-down truck ──
GOOGLE_PLACES_API_KEY=

# ── Optional: hours of the driver's local day the weekly check-in may be sent in (default 9-20), and the night
# hours (their local time, default 21-7) when texts that can wait (a move to a busier market, the check-in) wait ──
CARE_HOURS=
QUIET_HOURS=

# ── Optional: seconds an email the AI writes on its own to book, counter or accept waits for the owner's Undo
# (default 90; 0 sends at once). Each carrier can change theirs in Settings → Basics ──
UNDO_SECONDS=

# ── Optional: 1 = hold every text to a driver until they've said yes to texts (docs/legal/driver-text-consent.md).
# Off by default: they get the first text (who's texting, how to stop) before anything else ──
CONSENT_REQUIRED=

# ── Market rates: one service, whichever is set (DEPLOY.md, step 11) ──
GREENSCREENS_API_KEY=
GREENSCREENS_API_BASE=
# DAT RateView uses the DAT service account above, plus its lookup address:
DAT_RATES_URL=
# Or any other rate API: {{originCity}} {{originState}} {{destinationCity}} {{destinationState}} {{equipment}}
RATES_API_URL=
# "Header-Name: value"
RATES_API_HEADER=
RATES_API_NAME=
# Where the numbers are in the answer, e.g. data.rpm and data.high
RATES_RPM_PATH=
RATES_HIGH_PATH=

# ── Truck routing: HERE Routing v8 with transportMode=truck (DEPLOY.md, step 12) ──
HERE_API_KEY=

# ── Natural phone calls: the voice server in voice-server/, run outside Vercel (DEPLOY.md, step 13) ──
# Its public WebSocket address, e.g. wss://voice.backroute.com
VOICE_SERVER_URL=
# A long random secret, the same on the voice server
VOICE_SERVER_SECRET=

# ── Broker websites: the browser worker in portal-worker/, run outside Vercel (DEPLOY.md, step 15) ──
# A long random secret, the same on the worker
PORTAL_WORKER_SECRET=
# Encrypts carriers' website passwords: 32 random bytes, base64 (openssl rand -base64 32). Server only, never NEXT_PUBLIC.
PORTAL_VAULT_KEY=
# Only while changing the key: the previous one, so saved logins still open
PORTAL_VAULT_KEY_OLD=

# ── Broker credit (DEPLOY.md, step 14): any service that answers by MC number. Optional. ──
CREDIT_API_URL=
# "Header-Name: value"
CREDIT_API_HEADER=
# Where the numbers are in the answer (default score and daysToPay), and the service's top score (default 100)
CREDIT_SCORE_PATH=
CREDIT_DAYS_PATH=
CREDIT_SCORE_MAX=
CREDIT_API_NAME=

# Optional: turns on /api/eval/turn (eval/run.mjs: the AI scored on generated messages, dry run) and /api/sim (eval/sim.mjs:
# simulated brokers and drivers, on practice carriers it makes; nothing leaves). Leave unset in production unless you're measuring.
EVAL_SECRET=

# What things cost, for the support console's per-carrier estimate (Numbers tab). Optional: rough list prices are used
# when these aren't set. Dollars.
# COST_AI_INPUT_PER_MTOK=5
# COST_AI_OUTPUT_PER_MTOK=25
# COST_PER_TEXT=0.0083
# COST_PER_EMAIL=0.0012
# COST_PER_CALL_TURN=0.02

# ── Billing: Stripe (DEPLOY.md, step 16) ──
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# The monthly per-truck price's id (price_...)
STRIPE_PRICE_PER_TRUCK=
# Optional: days free (14), days a failed card keeps working (7), dollars per truck shown in Settings
BILLING_TRIAL_DAYS=
BILLING_GRACE_DAYS=
BILLING_PRICE_LABEL=
# 1 = no new bookings for an unpaid account (leave unset while testing)
BILLING_REQUIRED=

# ── Phone alerts: web push (DEPLOY.md, step 17). npx web-push generate-vapid-keys ──
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
# Server only, never NEXT_PUBLIC
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:support@yourdomain.com

# ── System alerts (DEPLOY.md, step 18): who's texted and emailed when something is down ──
ALERT_PHONES=
SUPPORT_EMAIL=

# Optional: most AI questions a signed-in account can ask in an hour (300)
AI_PER_USER_HOURLY=

# ── WhatsApp (DEPLOY.md, step 19): the dispatch line's WhatsApp sender and its approved template ──
TWILIO_WHATSAPP_FROM=
TWILIO_WHATSAPP_TEMPLATE_SID=
# The same number, shown in the driver app as "message dispatch on WhatsApp"
NEXT_PUBLIC_WHATSAPP_NUMBER=

# ── Voice messages (DEPLOY.md, step 20): transcribed by Deepgram, answered in voice (WhatsApp or MMS) by ElevenLabs ──
DEEPGRAM_API_KEY=
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
# Optional: DEEPGRAM_MODEL (nova-3), ELEVENLABS_MODEL (eleven_multilingual_v2)

# ── Optional: the drivers' morning text window (5-9, their local time), the owner's weekly review
# (REVIEW_DAY 1 = Monday, REVIEW_HOURS 7-11), and WEATHER_ALERTS=off to leave out weather ──
BRIEF_HOURS=
REVIEW_DAY=
REVIEW_HOURS=
WEATHER_ALERTS=
# Only for testing: where the weather warnings come from (default https://api.weather.gov)
WEATHER_API_BASE=
