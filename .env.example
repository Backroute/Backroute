# Copy to .env.local (never committed) and fill in. Everything is optional: with nothing set, the app is the demo.
# DEPLOY.md says where each value comes from and what it switches on.

# "off" on the real site removes the demo completely (no /demo, no demo links, no sample data). Leave unset on the demo site.
NEXT_PUBLIC_DEMO=

# ── Supabase: accounts, saved data ──
NEXT_PUBLIC_SUPABASE_URL=
# The anon / publishable key. Safe in the browser: the database's access rules still apply.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# The service_role / secret key: server only, for acting on texts, calls and email. Never NEXT_PUBLIC.
SUPABASE_SERVICE_ROLE_KEY=

# ── Anthropic (Claude): the AI ── server only
ANTHROPIC_API_KEY=
# "on" lets demo visitors get real AI answers too (15 an hour each). Costs you API usage.
AI_IN_DEMO=

# ── Twilio: the dispatch number drivers text and call ──
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# One of these two: the number itself (+14695550199) or a Messaging Service.
TWILIO_FROM_NUMBER=
TWILIO_MESSAGING_SERVICE_SID=
# Your public web address, e.g. https://backroute.vercel.app. Twilio signs requests with it.
PUBLIC_BASE_URL=

# ── Postmark: broker email ──
POSTMARK_SERVER_TOKEN=
# The verified address replies are sent from, e.g. dispatch@yourdomain.com
EMAIL_FROM=
# Postmark's inbound address, e.g. abc123@inbound.postmarkapp.com (each carrier gets +their-key)
EMAIL_INBOUND_ADDRESS=
# A long random secret, also put in the inbound webhook URL as ?token=
EMAIL_WEBHOOK_TOKEN=

# ── The jobs: the owner's evening text and the dispatcher's rounds (/api/cron/dispatch every ~10 minutes) ──
CRON_SECRET=

# ── FMCSA QCMobile web key (free: https://mobile.fmcsa.dot.gov/QCDevsite/): MC lookups at sign-up, and the AI's ──
# ── check of every broker before it books with them. Without it, new brokers wait for the support team.       ──
FMCSA_WEB_KEY=

# ── Backroute's support team: phones that get a text for anything urgent (a crash, a driver who can't be reached) ──
# Comma-separated, e.g. +13125550100,+13125550101. Support staff are added in the database (DEPLOY.md, "Your support team").
SUPPORT_PHONES=

# ── Load boards: Backroute's partner logins, set once each board's agreement is signed (DEPLOY.md, step 9). ──
# ── Until then, carriers can save their side and it waits.                                                  ──
TRUCKSTOP_WS_USERNAME=
TRUCKSTOP_WS_PASSWORD=
# The web-service address Truckstop gives with the login (their test one: https://testws.truckstop.com)
TRUCKSTOP_WS_BASE=
DAT_SERVICE_EMAIL=
DAT_SERVICE_PASSWORD=
# Only if DAT gives different addresses than the defaults
DAT_IDENTITY_BASE=
DAT_FREIGHT_BASE=

# ── Google Places API (New): repair shops, tire service and towing near a broken-down truck ──
GOOGLE_PLACES_API_KEY=

# ── Optional: hours of the driver's local day the weekly check-in may be sent in (default 9-20) ──
CARE_HOURS=
