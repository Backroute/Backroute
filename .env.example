# Copy to .env.local (never committed) and fill in. Everything is optional: with nothing set, the app is the demo.
# See DEPLOY.md for where each value comes from.

# Supabase: real accounts (sign-in by phone) and saved data. Use the anon / publishable key, never service_role.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# FMCSA QCMobile web key, for real MC-number lookups at sign-up.
# Free: register at https://mobile.fmcsa.dot.gov/QCDevsite/ and paste the key here (in .env.local, never committed).
# Without it, sign-up shows the demo fleet and says so.
FMCSA_WEB_KEY=

# Real AI (Claude): answers in "Ask the AI" and driver Messages, and reads rate con PDFs. Server-only, never
# NEXT_PUBLIC. Get a key at https://console.anthropic.com. Without it, chat uses the scripted demo replies.
ANTHROPIC_API_KEY=
# Let demo visitors (no account) get real AI answers too, 15 questions an hour each. Costs you API usage. Off unless "on".
AI_IN_DEMO=
